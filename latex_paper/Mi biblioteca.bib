@article{kim_use_2011,
	title = {Use of rotational friction dampers to enhance seismic and progressive collapse resisting capacity of structures},
	volume = {20},
	copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
	issn = {1541-7794, 1541-7808},
