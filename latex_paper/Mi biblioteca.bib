	pages = {566--578},
	file = {PDF:C\:\\Users\\Tartolas\\Zotero\\storage\\AUEX3ZN5\\Ribakov y Agranovich - 2011 - A method for design of seismic resistant structures with viscoelastic dampers.pdf:application/pdf},
}

