@article{pall_response_1982,
	title = {Response of {Friction} {Damped} {Braced} {Frames}},
	volume = {108},
	issn = {0044-8001, 2690-3377},
	url = {https://ascelibrary.org/doi/10.1061/JSDEAG.0005968},
