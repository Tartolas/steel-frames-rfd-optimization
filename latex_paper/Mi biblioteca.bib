	file = {PDF:C\:\\Users\\Tartolas\\Zotero\\storage\\D4T87W8U\\Zhang et al. - 2024 - Experimental and numerical studies on the cyclic behavior of a new metallic-friction hybrid damper.pdf:application/pdf},
