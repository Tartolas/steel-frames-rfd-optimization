}

@article{esfahani_experimental_2024,
	title = {Experimental and numerical study of the centripetal behavior of the divergent bracing frame equipped with rotational friction damper and shape memory bolts},
	volume = {438},
	issn = {09500618},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0950061824023870},
	doi = {10.1016/j.conbuildmat.2024.137245},
	abstract = {In seismic-prone regions, due to the presence of link beams as energy dissipating elements, eccentrically braced frames have always been of interest to designers and are a significant part of resilient seismic-resistant systems. On the other hand, numerous studies have shown that in addition to appropriate energy dissipation during the earthquake event, reducing residual responses of the system, such as relative inter-story drifts at the end of the earthquake event, is also very important. Therefore, in this study, a new hybrid system is presented by combining eccentrically braced frame with rotational friction damper for achieving energy dissipation and shape memory alloyed bolts for achieving flag-shape hysteretic behavior. To thoroughly examine the efficiency of the proposed system, two types of hybrid eccentrically braced frames are produced and their experimental results are compared with those of conventional corresponding frames. The results indicate that the proposed system exhibits appropriate self-centered behavior, and also, due to the incorporation of a rotational friction damper, the required energy dissipation is achieved. Comparing the energy dissipation among the frames, the highest amount of dissipation is related to the equipped symmetric frame due to more rotation of friction damper in comparison with unsymmetrical frame. In the following, in order to check the effectiveness of the proposed idea, models of 5, 10, and 15 floor symmetrical and asymmetrical frames were developed in OpenSEES software, and cyclic and dynamic analyses of time history were performed and observed on the models, equipping the frames with rotational friction dampers as well as shape memory alloyed bolts will reduce the floor displacement response and also the permanent displacement of the floors.},
	language = {en},
	urldate = {2025-05-05},
	journal = {Construction and Building Materials},
	author = {Esfahani, Ali Naseri and Zareei, Seyed Alireza and Birzhandi, Mohammad Sadegh and Zafarani, Mohammad Mahdi},
	month = aug,
	year = {2024},
	pages = {137245},
	file = {PDF:C\:\\Users\\Tartolas\\Zotero\\storage\\68Y9UQCV\\Esfahani et al. - 2024 - Experimental and numerical study of the centripetal behavior of the divergent bracing frame equipped.pdf:application/pdf},
}

